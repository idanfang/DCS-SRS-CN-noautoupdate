<Window FontFamily="Microsoft YaHei" x:Class="Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Installer"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="DCS-SRS 安装程序"
        Width="477.346"
        Height="408.114"
        ResizeMode="NoResize"
        mc:Ignorable="d">
    <Grid Name="containerPanel" Margin="0,0,4,0">
        <Label x:Name="intro"
               Margin="10,3,10,0"
               VerticalAlignment="Top"
               Content="DCS-SRS 安装程序 -"
               FontSize="20" />

        <Label x:Name="step2"
               Margin="10,45,10,0"
               VerticalAlignment="Top"
               Content="第 1 步：选择安装位置"
               FontSize="20" />

        <TextBox x:Name="srPath"
                 Width="330"
                 Height="23"
                 Margin="10,87,0,0"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Text="C:\Program Files\DCS-SimpleRadio-Standalone"
                 TextWrapping="Wrap" />
        <Button x:Name="srPathButton"
                Width="75"
                Margin="365,87,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Click="Set_Install_Path"
                Content="浏览…" />

        <Label x:Name="step3"
               Margin="10,120,10,0"
               VerticalAlignment="Top"
               Content="第 2 步：选择“保存的游戏”文件夹"
               FontSize="20" />


        <TextBox x:Name="dcsScriptsPath"
                 Width="330"
                 Height="23"
                 Margin="10,197,0,0"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Text="Saved Games"
                 TextWrapping="Wrap" />
        <Button x:Name="dcsPathButton"
                Width="75"
                Margin="365,198,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Click="Set_Scripts_Path"
                Content="浏览…" />

        <CheckBox x:Name="CreateStartMenuShortcut"
                  Content="创建开始菜单快捷方式"
                  HorizontalAlignment="Center"
                  Width="165"
                  Height="20"
                  Margin="146,300,133,37"
                  IsChecked="True" />

        <Button x:Name="InstallButton"
                Width="197"
                Margin="17,347,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Click="InstallReleaseButton"
                Content="安装 / 更新 DCS-SRS" />
        <GridSplitter x:Name="gridSplitter"
                      Width="5"
                      Height="20"
                      Margin="232,347,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top" />
        <Button x:Name="RemoveButton"
                Width="206"
                Margin="251,347,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Click="Remove_Plugin"
                Content="卸载 DCS-SRS" />
        <Label x:Name="step4"
			   Width="447"
               Height="40"
               Margin="10,223,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Content="第 3 步：安装或卸载 DCS-SRS"
               FontSize="20" />
        <CheckBox x:Name="InstallScriptsCheckbox"
            Content="安装 DCS 客户端脚本（仅安装服务器时无需勾选）"
            Height="20"
            Margin="17,150,10,197"
            IsChecked="True"
            Checked="InstallScriptsCheckbox_OnChecked"
            Unchecked="InstallScriptsCheckbox_OnUnchecked"/>
        <TextBlock Width="438"
                   IsEnabled="False"
            Height="50"
            Margin="10,257,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="12"
            TextWrapping="Wrap"
            ><Run x:Name="ServerNote"
				  Text="注意：DCS 服务器需手动安装 Scripts 文件夹中的 DCS-SRS-AutoConnectGameGUI.lua。安装说明见该文件。"/></TextBlock>

    </Grid>
</Window>